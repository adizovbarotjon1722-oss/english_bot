[
  {"id":"en_g_b_01","section":"grammar","level":"beginner","question":"She ___ a teacher.","options":["is","are","am","be"],"correct":0,"explanation":"'She' bilan 'is' ishlatiladi (3-shaxs birlik)."},
  {"id":"en_g_b_02","section":"grammar","level":"beginner","question":"They ___ from Uzbekistan.","options":["is","am","are","be"],"correct":2,"explanation":"'They' bilan 'are' ishlatiladi."},
  {"id":"en_g_b_03","section":"grammar","level":"beginner","question":"I ___ two brothers.","options":["has","have","having","had"],"correct":1,"explanation":"'I' bilan 'have' ishlatiladi (hozirgi zamon)."},
  {"id":"en_g_b_04","section":"grammar","level":"beginner","question":"This is ___ book.","options":["a","an","the","-"],"correct":0,"explanation":"'book' undosh tovush bilan boshlanadi, shuning uchun 'a'."},
  {"id":"en_g_b_05","section":"grammar","level":"beginner","question":"We ___ TV every evening.","options":["watch","watches","watching","watched"],"correct":0,"explanation":"Present Simple'da 'we' bilan fe'l o'zgarmaydi."},
  {"id":"en_g_b_06","section":"grammar","level":"beginner","question":"There ___ a cat on the table.","options":["is","are","be","am"],"correct":0,"explanation":"Birlik ot ('a cat') bilan 'is' ishlatiladi."},
