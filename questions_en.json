  {"id":"en_g_i_01","section":"grammar","level":"intermediate","question":"She ___ her homework when I called her.","options":["does","did","was doing","has done"],"correct":2,"explanation":"Past Continuous — jarayon o'tgan zamonda davom etayotgan edi."},
  {"id":"en_g_i_02","section":"grammar","level":"intermediate","question":"I ___ never ___ to Japan.","options":["have / been","has / been","had / gone","am / go"],"correct":0,"explanation":"Present Perfect: have/has + V3, tajriba bildiradi."},
  {"id":"en_g_i_03","section":"grammar","level":"intermediate","question":"If it rains, I ___ stay home.","options":["will","would","was","am"],"correct":0,"explanation":"Zero/First Conditional: if + Present, will + V1."},
  {"id":"en_g_i_04","section":"grammar","level":"intermediate","question":"This house was built ___ 1990.","options":["at","on","in","since"],"correct":2,"explanation":"Yillar bilan 'in' predlogi ishlatiladi."},
  {"id":"en_g_i_05","section":"grammar","level":"intermediate","question":"The book ___ by millions of people.","options":["read","reads","was read","is reading"],"correct":2,"explanation":"Passive Voice: was/were + V3."},
